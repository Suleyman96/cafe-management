{
  "name": "@gustri/database",
  "version": "1.0.0",
  "description": "Database types and schemas for Gustri",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "biome check ./src"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "keywords": [
    "shared",
    "types",
    "utilities"
  ],
  "author": "Gustri",
  "license": "UNLICENSED",
  "private": true
}
