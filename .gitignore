# Dependencies
node_modules/
.pnpm-store/
# This is a pnpm-only repo (pnpm-lock.yaml + --frozen-lockfile everywhere).
# Stray npm/yarn lockfiles drift silently and mislead Dependabot/contributors.
package-lock.json
yarn.lock

# Build outputs
dist/
.next/
.turbo/
out/
build/

# Deploy-time stamp (written by .github/workflows/deploy-*.yml, read by
# apps/staff-web/scripts/inject-sw-version.mjs). Never committed.
apps/*/.commit-sha

# Expo / React Native
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
apps/mobile/google-service-account.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# `.env*.local*` (with trailing *) catches both `.env.local` and
# variants like `.env.local.remote` that hold credentials for non-default
# Supabase projects. The previous pattern (`.env*.local` without trailing
# `*`) silently let `.env.local.remote` through.
.env*.local*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Supabase
supabase/.temp/

# Vercel
.vercel/

# Python
__pycache__/
*.pyc

# Misc
.cache/
*.pem

# Sentry — only the [defaults] section is committed; never commit auth tokens.
# (Comment intentional: file is committed, but reviewers should reject any PR
# that adds a `token=...` value to it.)

# Playwright test artifacts (generated; never committed)
playwright-report/
test-results/
