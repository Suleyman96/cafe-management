{
  "expo": {
    "name": "gustri",
    "slug": "gustri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gustri.app",
      "associatedDomains": ["applinks:app.gustri.com"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gustri.app",
      "permissions": ["NOTIFICATIONS", "VIBRATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "app.gustri.com" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": ["./assets/sounds/new_order.wav"]
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "gustri",
          "project": "gustri-mobile",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "scheme": "gustri",
    "extra": {
      "eas": {
        "projectId": "c0780054-a6d7-4e65-8ead-1a4b09f661a5"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c0780054-a6d7-4e65-8ead-1a4b09f661a5",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "enabled": true
    },
    "owner": "hajilov-k"
  }
}
