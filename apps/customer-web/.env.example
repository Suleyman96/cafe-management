# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Staff-web API URL. ADD-8: the browser now posts to customer-web's own
# same-origin BFF proxy; this URL is used SERVER-SIDE by that proxy to reach
# staff-web (and as the CORS connect-src origin). CUSTOMER_API_UPSTREAM_URL
# overrides it for the proxy if the server should reach a different/internal host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# CUSTOMER_API_UPSTREAM_URL=http://localhost:3001

# Customer API request signing (ADD-8). Server-only shared secret used to SIGN
# proxied /api/v1/customer/* requests. MUST match staff-web's
# CUSTOMER_API_SIGNING_SECRET. Leave unset to forward unsigned (safe default;
# staff-web then also skips verification). Generate with: openssl rand -hex 32
CUSTOMER_API_SIGNING_SECRET=

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
