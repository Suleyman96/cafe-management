# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: For authentication
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Customer-web URL (for CORS)
NEXT_PUBLIC_CUSTOMER_WEB_URL=http://localhost:3000

# Upstash Redis (required for rate limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Customer API request signing (ADD-8). Server-only shared secret used to VERIFY
# the HMAC signature on /api/v1/customer/* requests forwarded by customer-web's
# BFF proxy. MUST match customer-web's CUSTOMER_API_SIGNING_SECRET. Leave unset
# to disable verification (safe default — endpoints keep rate-limit + RLS).
# Generate with: openssl rand -hex 32
CUSTOMER_API_SIGNING_SECRET=

# Billing renewal reminders (manual billing). The daily billing-reminders cron
# (.github/workflows/billing-reminders.yml) calls /api/v1/platform/billing-reminders,
# which emails the operator about paid tenants expiring soon / overdue. DORMANT
# until BOTH an ESP key and recipients are set — the endpoint no-ops cleanly
# otherwise (the in-console banner is the primary reminder). PLATFORM_ADMIN_EMAILS
# (comma-separated) doubles as the digest recipients; BILLING_REMINDER_FROM is an
# optional verified sender.
RESEND_API_KEY=
BILLING_REMINDER_FROM=

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token